<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voiceInputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_top_backgroun_bottomsheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/dimen_24dp"
    android:paddingTop="@dimen/dimen_24dp"
    android:paddingEnd="@dimen/dimen_24dp"
    android:paddingBottom="@dimen/dimen_64dp">


    <!-- Fixed status text (e.g. Listening, Searching) -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dimen_6dp"
        android:text="Try asking about your daily horoscope or Kundli insights."
        android:textColor="@color/white"
        android:textSize="16sp" />

    <!-- Recognized speech text (dynamic) -->
    <TextView
        android:id="@+id/recognizedSpeechTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_18dp"
        android:gravity="center"
        android:text=""
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/visualizerContainer"
        android:layout_width="@dimen/dimen_64dp"
        android:layout_height="@dimen/dimen_64dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="@drawable/circular_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/bar1"
            android:layout_width="4dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/background_curv" />

        <View
            android:id="@+id/bar2"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_margin="2dp"
            android:background="@drawable/background_curv" />

        <View
            android:id="@+id/bar3"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_margin="2dp"
            android:background="@drawable/background_curv" />

        <View
            android:id="@+id/bar4"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_margin="2dp"
            android:background="@drawable/background_curv" />

        <View
            android:id="@+id/bar5"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_margin="2dp"
            android:background="@drawable/background_curv" />
    </LinearLayout>

    <!-- Button to start/stop listening -->
    <ImageView
        android:id="@+id/buttonStartStop"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_background"
        android:contentDescription="Start/Stop Listening"
        android:padding="12dp"
        android:src="@drawable/ic_mic" />

    <!-- Tap-to-speak prompt (optional) -->
    <TextView
        android:id="@+id/tapToSpeakText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:gravity="center"
        android:text="Tap Microphone to Speak"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
