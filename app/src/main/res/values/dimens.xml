    <style name="BlueButton">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15dp</item>
        <item name="android:background">#002E6E</item>
    </style>

    <style name="GreyButton">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15dp</item>
        <item name="android:background">#9B9B9B</item>
    </style>

    <style name="ProgressBarTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorAccent">@color/color_00b9f5</item>

    </style>

    <style name="TransparentProgressDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <declare-styleable name="OtpEditText">
        <attr name="otpInputAnimStyle" format="enum">
            <enum name="popIn" value="0" />
            <enum name="fromBottom" value="1" />
            <enum name="none" value="-1" />
        </attr>
        <attr name="otpErrorAnimStyle" format="enum">
            <enum name="shake" value="0" />
            <enum name="bounce" value="1" />
            <enum name="none" value="-1" />
        </attr>
        <attr name="otpStrokeLineHeight" format="dimension" />
        <attr name="otpStrokeLineSelectedHeight" format="dimension" />
        <attr name="otpCharacterSpacing" format="dimension" />
        <attr name="otpTextBottomLinePadding" format="dimension" />
        <attr name="otpBackgroundDrawable" format="reference" />
        <attr name="otpBackgroundIsSquare" format="boolean" />
        <attr name="otpErrorTextColor" format="color" />
        <attr name="otpLineUnFocusedColor" format="color" />
        <attr name="otpLineFocusedColor" format="color" />
        <attr name="otpLineNextCharColor" format="color" />
        <attr name="otpLineErrorColor" format="color" />

    </declare-styleable>
    <declare-styleable name="RoboTextView">
        <attr name="fontType">
            <enum name="robotoLight" value="1" />
            <enum name="robotoRegular" value="2" />
            <enum name="robotoMedium" value="3" />
            <enum name="robotoBold" value="4" />
            <enum name="robotoItalic" value="5" />

        </attr>
    </declare-styleable>

